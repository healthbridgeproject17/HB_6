FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-too-to-another-long-random-string
DATABASE_URL=paste-your-neon-connection-string-here
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@healthbridge.local
ADMIN_PASSWORD=choose-a-strong-password
# Key that encrypts uploaded files on disk. Create one with:
#   .\.venv\Scripts\flask.exe --app run generate-key
# Keep it safe: without it, stored documents cannot be read. Required in production.
DOCUMENT_ENCRYPTION_KEY=
